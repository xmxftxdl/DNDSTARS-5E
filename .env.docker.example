# 复制为 .env 后再按部署环境修改。不要把真实域名以外的秘密提交到 Git。
COMPOSE_PROJECT_NAME=dndstars-5e

# 默认仅监听本机，供同机 Caddy/nginx/Traefik 转发。
STARS_BIND_ADDRESS=127.0.0.1
STARS_PORT=8080

# 本机验证可使用 http://localhost:8080；公网必须是玩家实际访问的 HTTPS 源。
STARS_PUBLIC_ORIGIN=http://localhost:8080
STARS_ALLOWED_ORIGINS=

# 建议使用 Git commit、发布日期或镜像版本号。
STARS_BUILD_ID=docker-local
STARS_IMAGE=dndstars-5e
STARS_IMAGE_TAG=local

# Docker json-file 日志轮转。
STARS_LOG_MAX_SIZE=10m
STARS_LOG_MAX_FILES=3

# 邮箱/短信验证码发送 Webhook。生产环境至少配置一种；密钥只写入服务器 .env。
STARS_VERIFICATION_WEBHOOK_URL=
STARS_EMAIL_VERIFICATION_WEBHOOK_URL=
STARS_SMS_VERIFICATION_WEBHOOK_URL=
STARS_VERIFICATION_WEBHOOK_SECRET=

# 腾讯云国际版直连；可替代上面的 Webhook。SecretId/SecretKey 只填写到服务器 .env。
STARS_TENCENTCLOUD_EDITION=international
STARS_TENCENTCLOUD_SECRET_ID=
STARS_TENCENTCLOUD_SECRET_KEY=

# 邮件渠道：SES 国际版、ap-singapore；模板正文只使用 {{code}} 一个变量。
STARS_TENCENT_SES_FROM_EMAIL=
STARS_TENCENT_SES_TEMPLATE_ID=
STARS_TENCENT_SES_SUBJECT=Astral Trace 账号验证码

# 手机渠道：Global SMS；模板正文只使用 {1} 一个变量。
STARS_TENCENT_SMS_SDK_APP_ID=
STARS_TENCENT_SMS_TEMPLATE_ID=
STARS_TENCENT_SMS_SIGN_NAME=

# 仅用于旧客户端迁移；正式注册系统启用后应保持 false。
STARS_ALLOW_LEGACY_ACCOUNT_CREATION=false
