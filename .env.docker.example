# 复制为 .env 后再按部署环境修改。不要把真实域名以外的秘密提交到 Git。
COMPOSE_PROJECT_NAME=dndstars-5e

# 默认仅监听本机，供同机 Caddy/nginx/Traefik 转发。
STARS_BIND_ADDRESS=127.0.0.1
STARS_PORT=8080

# 本机验证可使用 http://localhost:8080；公网必须是玩家实际访问的 HTTPS 源。
STARS_PUBLIC_ORIGIN=http://localhost:8080
STARS_ALLOWED_ORIGINS=

# 建议使用 Git commit、发布日期或镜像版本号。
STARS_BUILD_ID=docker-local
STARS_IMAGE=dndstars-5e
STARS_IMAGE_TAG=local

# 账号、会话、身份、战役索引、订单、账本和提现使用 PostgreSQL；房间实时资源仍保留 JSON + 快照。
STARS_ACCOUNT_STORAGE=postgres
STARS_DATABASE_PATH=/data/astraltrace.sqlite
STARS_POSTGRES_DB=astraltrace
STARS_POSTGRES_USER=astraltrace
STARS_POSTGRES_PASSWORD=replace-with-a-long-random-password
STARS_DATABASE_POOL_SIZE=10

# Docker json-file 日志轮转。
STARS_LOG_MAX_SIZE=10m
STARS_LOG_MAX_FILES=3
# 默认不记录客户端 IP；仅在已更新隐私政策且确有排障需要时开启。
STARS_LOG_CLIENT_IP=false
STARS_METRICS_TOKEN=replace-with-a-long-random-metrics-token
STARS_ALERT_WEBHOOK_URL=
STARS_ALERT_WEBHOOK_SECRET=
STARS_BACKUP_INTERVAL_SECONDS=86400
STARS_BACKUP_RETENTION_DAYS=14
STARS_BACKUP_HOST_PATH=./backups

# 邮箱/短信验证码发送 Webhook。生产环境至少配置一种；密钥只写入服务器 .env。
STARS_VERIFICATION_WEBHOOK_URL=
STARS_EMAIL_VERIFICATION_WEBHOOK_URL=
STARS_SMS_VERIFICATION_WEBHOOK_URL=
STARS_VERIFICATION_WEBHOOK_SECRET=

# 腾讯云 SES 直连；中国站用 mainland（广州默认），国际站用 international（新加坡）。SecretId/SecretKey 只填写到服务器 .env。
STARS_TENCENTCLOUD_EDITION=mainland
STARS_TENCENTCLOUD_SECRET_ID=
STARS_TENCENTCLOUD_SECRET_KEY=

# 邮件渠道：中国站支持 ap-guangzhou（默认）或 ap-hongkong；国际站固定 ap-singapore。模板正文使用 {{code}} 变量。
STARS_TENCENT_SES_FROM_EMAIL=
STARS_TENCENT_SES_TEMPLATE_ID=
STARS_TENCENT_SES_REGION=
STARS_TENCENT_SES_SUBJECT=Astral Trace 账号验证码

# 手机渠道：中国站默认 ap-guangzhou，国际站可选 ap-singapore 或 eu-frankfurt；模板正文只使用 {1} 一个变量。
STARS_TENCENT_SMS_SDK_APP_ID=
STARS_TENCENT_SMS_TEMPLATE_ID=
STARS_TENCENT_SMS_SIGN_NAME=
STARS_TENCENT_SMS_REGION=

# 仅用于旧客户端迁移；正式注册系统启用后应保持 false。
STARS_ALLOW_LEGACY_ACCOUNT_CREATION=false

# 扩展市场支付适配器回调密钥。生产环境必须使用独立的高强度随机值。
# 支付提供商适配器应以该密钥对原始 JSON 请求体生成 HMAC-SHA256 十六进制签名。
STARS_MARKETPLACE_PAYMENT_WEBHOOK_SECRET=

# 可选：平台到支付适配器的下单接口。正式环境仅接受 HTTPS。
STARS_MARKETPLACE_CHECKOUT_ADAPTER_URL=
STARS_MARKETPLACE_CHECKOUT_ADAPTER_SECRET=
STARS_MARKETPLACE_CHECKOUT_PROVIDER=
