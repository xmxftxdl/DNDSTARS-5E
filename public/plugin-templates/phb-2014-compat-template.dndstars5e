/*
 * DNDSTARS 5E · PHB 2014 compatibility template
 *
 * This file deliberately contains no Player's Handbook rules text, names, tables,
 * artwork, or other non-SRD content. Replace the demo content only with material
 * you are authorized to use. Keep the bundle self-contained: do not load external modules.
 */

const plugin = {
  manifest: {
    id: 'local.example.phb-2014-template',
    name: 'PHB 2014 兼容模板（演示）',
    version: '0.1.0',
    apiVersion: 2,
    rulesetId: 'dnd5e-2014-srd-5.1',
    stateSchemaVersion: 1,
    publisher: '本地用户',
    license: 'CC0-1.0（仅模板与原创演示内容）',
    description: '不含 PHB 原文的 Rules Plugin API V2 纵向切片模板。',
  },

  setup(api) {
    if (
      typeof document !== 'undefined' ||
      typeof window !== 'undefined' ||
      typeof localStorage !== 'undefined' ||
      typeof indexedDB !== 'undefined' ||
      typeof fetch !== 'undefined' ||
      typeof WebSocket !== 'undefined' ||
      typeof postMessage !== 'undefined'
    ) {
      throw new Error('该规则包必须在 DNDSTARS Worker 沙箱中运行')
    }
    api.registerHeadlessAction({
      id: 'guardian-spark',
      rolls: [{ id: 'temporary-hp', label: '守护火花', count: 1, sides: 4, modifier: 2, visibility: 'public' }],
      resolve({ target, rolls, grantTemporaryHitPoints, succeed, fail }) {
        if (!target) return fail('invalid-target')
        grantTemporaryHitPoints(target.id, rolls['temporary-hp'].total)
        return succeed()
      },
    })

    api.registerFeature({
      id: 'guardian-spark',
      name: '演示特性：守护火花',
      summary: '原创的接口演示特性，不属于 D&D 官方规则内容。',
      description: '以一个动作选择30尺内的自己或一名友方生物；目标获得1d4＋2点临时生命值。',
      sourceLabel: 'Rules Plugin API V2 演示',
      minimumLevel: 1,
      automation: 'full',
      action: {
        id: 'guardian-spark',
        label: '使用守护火花',
        description: '由玩家提交目标，DM 重新计算阵营、距离与行动经济，再交给 Headless resolver。',
        economy: 'action',
        targeting: {
          kind: 'single-creature',
          relation: 'ally',
          rangeFeet: 30,
          includeSelf: true,
        },
      },
    })

    api.registerHeadlessAction({
      id: 'ember-lance',
      rolls: [{ id: 'damage', label: '余烬长枪伤害', count: 2, sides: 6, visibility: 'public' }],
      resolve({ target, rolls, dealDamage, succeed, fail }) {
        if (!target) return fail('invalid-target')
        dealDamage(target.id, rolls.damage.total, 'fire')
        return succeed()
      },
    })

    let starChargesId = ''
    api.registerHeadlessAction({
      id: 'starlight-field',
      rolls: [{ id: 'damage', label: '星辉领域伤害', count: 1, sides: 6, visibility: 'public' }],
      resolve({ action, targets, rolls, spendResource, dealDamage, succeed, fail }) {
        if (action.interruptChoiceId !== 'cast') return fail('invalid-plugin-action')
        if (!starChargesId || !spendResource(starChargesId, 1)) return fail('class-resource-unavailable')
        for (const target of targets) dealDamage(target.id, rolls.damage.total, 'radiant')
        return succeed()
      },
    })
    api.registerSubclass({
      id: 'astral-school',
      classId: 'wizard',
      name: '演示子职：星辉学派',
      summary: '原创的声明式子职、选择组、资源与持续区域演示，不属于官方规则。',
      features: [{
        id: 'starlight-field',
        level: 2,
        name: '星辉领域',
        description: '消耗1点星辉充能，在60尺内放置一个持续区域。',
        action: {
          id: 'starlight-field',
          label: '放置星辉领域',
          economy: 'action',
          targeting: {
            kind: 'area',
            relation: 'enemy',
            maximumTargets: 8,
            template: { shape: 'circle', origin: 'point', radiusFeet: 10, placeRangeFeet: 60 },
          },
          interrupt: {
            prompt: '是否消耗星辉充能并建立专注区域？',
            audience: 'actor',
            options: [{ id: 'cast', label: '建立领域' }, { id: 'cancel', label: '取消' }],
            defaultOptionId: 'cancel',
          },
          persistentArea: {
            label: '星辉领域（原创演示）',
            color: '#8b5cf6',
            durationRounds: 10,
            concentration: true,
          },
        },
      }],
      choiceGroups: [{
        id: 'star-color',
        level: 2,
        name: '星辉色彩',
        maxSelections: 1,
        options: [
          { id: 'violet', name: '紫色星辉', summary: '原创演示选项。' },
          { id: 'gold', name: '金色星辉', summary: '原创演示选项。' },
        ],
      }],
    })
    starChargesId = api.registerResource({
      id: 'star-charges',
      label: '星辉充能',
      classId: 'wizard',
      subclassId: 'astral-school',
      minimumLevel: 2,
      maximum: [0, 2, 3, 3, 4],
      resetOn: 'short-rest',
    })

    api.registerSpell({
      id: 'ember-lance',
      name: '余烬长枪（原创演示）',
      englishName: 'Ember Lance',
      level: 1,
      school: 'evocation',
      ritual: false,
      castingTime: { value: 1, unit: 'action' },
      range: { type: 'distance', feet: 60 },
      components: {
        verbal: true,
        somatic: true,
        material: true,
        materialText: '一小块燧石',
        materialCostGp: 0,
        materialConsumed: false,
      },
      duration: { type: 'instantaneous', concentration: false },
      classes: ['sorcerer', 'wizard'],
      description: '原创的法术模板示例；失败的敏捷豁免会受到火焰伤害并短暂目盲。',
      higherLevels: '每使用高于1环的法术位一环，伤害增加1d6。',
      tags: ['伤害', '火焰', '状态'],
      mechanics: {
        kind: 'damage',
        resolution: 'saving-throw',
        savingThrow: { ability: 'dex', onSuccess: 'half' },
        damage: { dice: { count: 2, sides: 6, bonus: 0 }, type: 'fire' },
        conditions: [{
          condition: 'blinded',
          trigger: 'on-failed-save',
          duration: { kind: 'target-next-turn-start' },
        }],
        upcast: {
          fromSlotLevel: 2,
          effects: [{ kind: 'damage-dice', diceCountPerSlot: 1 }],
        },
      },
      automation: { mode: 'headless-action', actionId: 'ember-lance' },
    })
  },
}

export default plugin
