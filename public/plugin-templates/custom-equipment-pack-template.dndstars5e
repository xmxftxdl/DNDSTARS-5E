  },

  setup(api) {
    api.registerItem({
      id: 'star-iron-longsword-plus-1',
      name: '演示星铁长剑 +1',
      englishName: 'Demo Star-Iron Longsword +1',
      category: 'equipment',
      icon: 'weapon',
      description: '一柄只用于验证装备导入和 Headless 攻击修正的原创演示长剑。',
      rulesText: '装备后，使用此武器进行攻击检定与伤害掷骰时获得 +1 加值。',
      weightLb: 3,
      cost: { amount: 250, currency: 'gp' },
      stackable: false,
      equipment: {
        slot: 'mainWeapon',
        effects: { weaponAttackBonus: 1, weaponDamageBonus: 1 },
        dnd5e: {
          kind: 'weapon',
          category: 'martial',
          mode: 'melee',
          damage: { count: 1, sides: 8, type: 'slashing' },
          attackAbility: 'str',
          reachFeet: 5,
          properties: ['多才多艺（1d10）'],
        },
      },
    })

    api.registerItem({
      id: 'wayfarer-cloak',
      name: '演示远行斗篷',
      englishName: 'Demo Wayfarer Cloak',
      category: 'equipment',
      icon: 'armor',
      description: '一件用于验证非武器装备效果的原创演示斗篷。',
      rulesText: '装备后 AC +1、全部豁免 +1，步行速度增加 5 尺。',
      weightLb: 1,
      stackable: false,
      equipment: {
        slot: 'necklace',
        effects: { armorClassBonus: 1, savingThrowBonus: 1, speedBonusFeet: 5 },
      },
    })

    api.registerItem({
      id: 'field-tonic',
      name: '演示野战补剂',
      englishName: 'Demo Field Tonic',
      category: 'consumable',
      icon: 'healing-potion',
