{
  "name": "dndstars-5e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:dm": "node scripts/vite-server.mjs --host 127.0.0.1 --port 5273 --strictPort",
    "dev:player": "node scripts/vite-server.mjs --host 127.0.0.1 --port 5274 --strictPort",
    "dev:player1": "node scripts/vite-server.mjs --host 127.0.0.1 --port 5274 --strictPort",
    "dev:player2": "node scripts/vite-server.mjs --host 127.0.0.1 --port 5275 --strictPort",
    "dev:player3": "node scripts/vite-server.mjs --host 127.0.0.1 --port 5276 --strictPort",
    "dev:table": "node scripts/start-table.mjs",
    "serve:dm": "node scripts/static-server.mjs --host 127.0.0.1 --port 5273 --root dist",
    "serve:player": "node scripts/static-server.mjs --host 127.0.0.1 --port 5274 --root dist",
    "serve:player1": "node scripts/static-server.mjs --host 127.0.0.1 --port 5274 --root dist",
    "serve:player2": "node scripts/static-server.mjs --host 127.0.0.1 --port 5275 --root dist",
    "serve:player3": "node scripts/static-server.mjs --host 127.0.0.1 --port 5276 --root dist",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "lint:full": "eslint .",
    "lint:ratchet": "node scripts/eslint-ratchet.mjs",
    "check:fast": "npm run typecheck && npm run lint",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:srd-content": "vitest run src/rulesets/dnd5e/srdContentAudit.test.ts",
    "migrate:sqlite": "node scripts/migrate-json-indexes-to-sqlite.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "generate:srd-monsters": "node scripts/generate-srd-monsters.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@tailwindcss/vite": "^4.3.0",
    "konva": "^10.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
