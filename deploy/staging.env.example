COMPOSE_PROJECT_NAME=astraltrace-staging
STARS_BIND_ADDRESS=127.0.0.1
STARS_PORT=8081
STARS_PUBLIC_ORIGIN=https://staging.astraltracevtt.com
STARS_ALLOWED_ORIGINS=
STARS_BUILD_ID=staging-local
STARS_IMAGE=dndstars-5e
STARS_IMAGE_TAG=staging
STARS_ART_ASSET_HOST_PATH=/opt/astraltrace/staging/app/public
STARS_REQUIRE_ART_ASSET_PACK=true
STARS_ART_ASSET_MANIFEST_SHA256=
STARS_ACCOUNT_STORAGE=postgres
STARS_POSTGRES_DB=astraltrace_staging
STARS_POSTGRES_USER=astraltrace_staging
STARS_POSTGRES_PASSWORD=replace-with-a-unique-long-random-staging-password
STARS_DATABASE_POOL_SIZE=5
STARS_LOG_CLIENT_IP=false
STARS_METRICS_TOKEN=replace-with-a-unique-long-random-staging-metrics-token
STARS_ALERT_WEBHOOK_URL=
STARS_ALERT_WEBHOOK_SECRET=
STARS_BACKUP_INTERVAL_SECONDS=86400
STARS_BACKUP_RETENTION_DAYS=7
STARS_BACKUP_HOST_PATH=/opt/astraltrace/staging/backups
STARS_ALLOW_LEGACY_ACCOUNT_CREATION=false
STARS_VERIFICATION_WEBHOOK_URL=
STARS_EMAIL_VERIFICATION_WEBHOOK_URL=
STARS_SMS_VERIFICATION_WEBHOOK_URL=
STARS_VERIFICATION_WEBHOOK_SECRET=
STARS_MARKETPLACE_PAYMENT_WEBHOOK_SECRET=
STARS_MARKETPLACE_CHECKOUT_ADAPTER_URL=
STARS_MARKETPLACE_CHECKOUT_ADAPTER_SECRET=
STARS_MARKETPLACE_CHECKOUT_PROVIDER=
STARS_TENCENTCLOUD_EDITION=
STARS_TENCENTCLOUD_SECRET_ID=
STARS_TENCENTCLOUD_SECRET_KEY=
STARS_TENCENT_SES_FROM_EMAIL=
STARS_TENCENT_SES_TEMPLATE_ID=
STARS_TENCENT_SES_REGION=
STARS_TENCENT_SES_SUBJECT=Astral Trace Staging 账号验证码
STARS_TENCENT_SMS_SDK_APP_ID=
STARS_TENCENT_SMS_TEMPLATE_ID=
STARS_TENCENT_SMS_SIGN_NAME=
STARS_TENCENT_SMS_REGION=
