[Unit]
Description=Astral Trace VTT consistent Docker data backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/astraltrace/app
Environment=STARS_BACKUP_DIR=/opt/astraltrace/backups
Environment=STARS_BACKUP_RETENTION_DAYS=14
ExecStart=/opt/astraltrace/app/scripts/backup-docker-data.sh
